# Copia este archivo a .env (local) o define estas variables en el panel de tu
# proveedor (Render > Environment). NUNCA subas el .env real a un repositorio.

# --- Panel en la nube (obligatorias fuera de localhost) ---
# Contraseña de acceso al panel (mín. 12 caracteres). Sin ella, el panel se
# niega a escuchar en una dirección pública.
HUBCLIPS_PASSWORD=
# Clave larga y aleatoria (mín. 24 caracteres) para cifrar los tokens y firmar
# las sesiones. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
HUBCLIPS_SECRET_KEY=
# Carpeta persistente para clips, registros y destinos.json (en local: ./datos)
# HUBCLIPS_DATA_DIR=/data
# Hosts permitidos (separados por comas) si usas un dominio propio.
# HUBCLIPS_ALLOWED_HOSTS=hubclips.midominio.com

# --- OAuth de las redes (solo las que uses) ---
# La URL de retorno que debes registrar en cada consola es
#   <URL pública>/auth/<youtube|tiktok|facebook>/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://hubclips.midominio.com/auth/tiktok/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# URL pública del panel (en Render se detecta sola con RENDER_EXTERNAL_URL).
# OAUTH_BASE_URL=https://hubclips.onrender.com

# --- Rendimiento (opcionales) ---
# HUBCLIPS_HILOS_FFMPEG=2
# HUBCLIPS_EXPORTS_PARALELAS=1
# HUBCLIPS_ENCODER=cpu
